			class CustomAttributes
			{
				class Attribute0
				{
					property="FLS_IText";
					expression="_this setVariable ['FLS_IText', _value];";
					class Value
					{
						class data
						{
							singleType="STRING";
							value="<t size='1.6'>Мурманская операция. Сентябрь 1941 года.</t><br/> " \n "<t size='1.3'>Наступление немецких и финских войск на мурманском и беломорско-карельском участках фронта в самом разгаре.</t><br/> " \n "<t size='1.3'>Задача армии «Норвегия» - выйти к Кировской железной дороге и побережью Белого моря.</t><br/> " \n "<t size='1.3'>Перерезав дорогу, войска отрежут Мурманск и Северный флот от остальной страны.</t><br/> " \n "<t size='1.3'>Горные егеря превосходят противника в подготовке, снаряжении и опыте.</t><br/> " \n "<t size='1.3'>Но в тундре нет дорог, снабжение идёт с трудом, а советская оборона с каждым днём крепнет.</t><br/> " \n "<t size='1.3'>Пограничные заставы противника отброшены, однако темп наступления падает.</t><br/> " \n "<t size='1.3'>Командование приказывает прорвать оборону до наступления зимы.</t><br/> " \n "<t size='1.9'>Вперёд,</t> " \n "<t size='1.9'>к Белому морю!</t>";
						};
					};
				};
