		class Item32
		{
			dataType="Logic";
			class PositionInfo
			{
				position[]={-3.8737936,6.2700019,-3.1100504};
			};
			id=2750;
			type="FLS_Module_Intro";
			atlOffset=1.9073486e-06;
			class CustomAttributes
			{
				class Attribute0
				{
					property="FLS_IText";
					expression="_this setVariable ['FLS_IText', _value];";
					class Value
					{
						class data
						{
							singleType="STRING";
							value="<t size='1.6'>Мурманская операция. Сентябрь 1941 года.</t><br/> " \n "<t size='1.3'>Наступление немецких и финских войск на мурманском и беломорско-карельском участках Северного фронта в самом разгаре.</t><br/> " \n "<t size='1.3'>Немецко-фашистские захватчики намереваются пробиться к Кировской железной дороге и побережью Белого моря.</t><br/>  " \n "<t size='1.3'>Это единственная сухопутная связь Мурманска с остальной страной.</t><br/>  " \n "<t size='1.3'>Численность советских войск не превышает 7 тысяч человек.</t><br/> " \n "<t size='1.3'>С учётом горной подготовки, специального снаряжения и опыта у немецких горных егерей было неоспоримое преимущество.</t><br/> " \n "<t size='1.3'>Две из трёх застав, сражаясь, отступили под давлением превосходящих сил противника.</t><br/> " \n "<t size='1.3'>Командование приказывает остановить наступление.</t><br/> " \n "<t size='1.9'>Любой ценой.</t>";
						};
					};
				};
				class Attribute1
				{
					property="FLS_IBlack";
					expression="_this setVariable ['FLS_IBlack',_value,true];";
